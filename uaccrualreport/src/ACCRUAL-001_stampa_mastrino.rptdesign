                                <text-property name="content"><![CDATA[STAMPA MASTRINO]]></text-property>
                            </text>
                        </cell>
                    </row>
                    <row id="13">
                        <cell id="14">
                            <text-data id="21">
                                <property name="fontWeight">bold</property>
                                <property name="textAlign">center</property>
                                <expression name="valueExpr">"Anno di gestione " +params["anno_bilancio"].value+ " periodo dal " +Formatter.format(params["data_da"].value,'dd/MM/yyyy') + " al "+Formatter.format(params["data_a"].value,'dd/MM/yyyy')</expression>
                                <property name="contentType">html</property>
                            </text-data>
                        </cell>
                    </row>
                </grid>
            </page-header>
            <page-footer>
                <text id="3">
                    <property name="contentType">html</property>
                    <text-property name="content"><![CDATA[<value-of>Formatter.format(new Date(),"dd/MM/yyyy HH:mm")</value-of>]]></text-property>
                </text>
            </page-footer>
        </simple-master-page>
