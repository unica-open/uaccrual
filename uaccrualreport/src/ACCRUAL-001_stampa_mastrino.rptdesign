                    <text-property name="displayName">attributi_bold</text-property>
                    <expression name="expression" type="javascript">if(row["elenco_attributi"] != "") {&#13;
	var str = row["elenco_attributi"];  &#13;
&#13;
	var parti = str.split(", ");&#13;
	var risultato = "";&#13;
&#13;
	for (var i = 0; i &lt; parti.length; i++) {&#13;
    	var pezzi = parti[i].split("-");&#13;
    	risultato += "&lt;b>" + pezzi[0] + "&lt;/b>-" + pezzi[1];&#13;
    &#13;
    	if (i &lt; parti.length - 1) {&#13;
        	risultato += ", ";&#13;
    	}&#13;
	}&#13;
}&#13;
else risultato="";&#13;
&#13;
risultato;</expression>
