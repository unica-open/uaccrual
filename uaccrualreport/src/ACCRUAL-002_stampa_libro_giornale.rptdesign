                    <property name="name">ordina</property>
                    <property name="nativeName">ordina</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select tipopn.prima_nota_tipo_id, tipopn.prima_nota_tipo_codice, tipopn.prima_nota_tipo_descrizione,
	tipopn.prima_nota_tipo_codice||' - '||tipopn.prima_nota_tipo_descrizione tipologia_completa,
	tipopn.prima_nota_tipo_codice ordina
from accrual_d_prima_nota_tipo tipopn
where tipopn.gest_data_del IS NULL
UNION 
select 0 prima_nota_tipo_id, 'T' prima_nota_tipo_codice, 'Tutte' prima_nota_tipo_descrizione,
	'T - Tutte' tipologia_completa, 'ZZZ' ordina
order by ordina]]></xml-property>
        </oda-data-set>
