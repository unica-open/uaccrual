            <xml-property name="queryText"><![CDATA[select dstato.prima_nota_stato_codice, dstato.prima_nota_stato_descrizione,
	dstato.prima_nota_stato_codice ||' - ' || dstato.prima_nota_stato_descrizione stato_completo
from accrual_d_prima_nota_stato dstato
where dstato.prima_nota_stato_codice <> 'A'
and dstato.gest_data_del IS NULL
UNION
select 'T' prima_nota_stato_codice, 'Tutti' prima_nota_stato_descrizione,
'T - Tutti' stato_completo
order by prima_nota_stato_codice]]></xml-property>
