            <xml-property name="queryText"><![CDATA[select  fonte.fonte_codice, fonte.fonte_descrizione,
	fonte.fonte_codice||' - '||fonte.fonte_descrizione fonte_completa,
    evento.evento_codice, evento.evento_descrizione, 
    evento.evento_codice||' - '||evento.evento_descrizione evento_completo,
    cau.causale_codice, cau.causale_descrizione,
    cau.causale_codice||' - '|| cau.causale_descrizione causale_completa,
    upper(fonte.fonte_codice) ordina_fonte, upper(evento.evento_codice) ordine_codice,
    upper(cau.causale_codice) ordina_causale
from accrual_t_evento evento, 
	accrual_t_causale cau,
    accrual_d_fonte fonte,
    accrual_r_evento_fonte r_ev_fonte,
    accrual_r_causale_stato r_cau_stato,
    accrual_d_causale_stato d_cau_stato
where evento.evento_id=cau.evento_id
and evento.evento_id=r_ev_fonte.evento_id
and r_cau_stato.causale_id=cau.causale_id
and r_cau_stato.causale_stato_id=d_cau_stato.causale_stato_id
and evento.ente_id=?
and d_cau_stato.causale_stato_codice='V'
and evento.gest_data_del IS NULL
and cau.gest_data_del IS NULL   
and fonte.gest_data_del IS NULL    
and r_ev_fonte.gest_data_del IS NULL   
and r_cau_stato.gest_data_del IS NULL  
UNION
select 'T' fonte_codice, 'Tutte' fonte_descrizione,
	'T - Tutte' fonte_completa,
    evento.evento_codice, evento.evento_descrizione, 
    evento.evento_codice||' - '||evento.evento_descrizione evento_completo,
    cau.causale_codice, cau.causale_descrizione,
    cau.causale_codice||' - '|| cau.causale_descrizione causale_completa,
    'ZZZ' ordina_fonte, upper(evento.evento_codice) ordine_codice,
    upper(cau.causale_codice) ordina_causale
from accrual_t_evento evento, 
	accrual_t_causale cau,
    accrual_d_fonte fonte,
    accrual_r_evento_fonte r_ev_fonte,
    accrual_r_causale_stato r_cau_stato,
    accrual_d_causale_stato d_cau_stato
where evento.evento_id=cau.evento_id
and evento.evento_id=r_ev_fonte.evento_id
and r_ev_fonte.fonte_id=fonte.fonte_id
and r_cau_stato.causale_id=cau.causale_id
and r_cau_stato.causale_stato_id=d_cau_stato.causale_stato_id
and evento.ente_id=?
and d_cau_stato.causale_stato_codice='V'
and evento.gest_data_del IS NULL
and cau.gest_data_del IS NULL   
and fonte.gest_data_del IS NULL    
and r_ev_fonte.gest_data_del IS NULL   
and r_cau_stato.gest_data_del IS NULL  
UNION
select fonte.fonte_codice, fonte.fonte_descrizione,
	fonte.fonte_codice||' - '||fonte.fonte_descrizione fonte_completa,
    'T' evento_codice, 'Tutti' evento_descrizione, 
    'T - Tutti' evento_completo,
    cau.causale_codice, cau.causale_descrizione,
    cau.causale_codice||' - '|| cau.causale_descrizione causale_completa,
    upper(fonte.fonte_codice) ordina_fonte, 'ZZZ' ordine_codice,
    upper(cau.causale_codice) ordina_causale
from accrual_t_evento evento, 
	accrual_t_causale cau,
    accrual_d_fonte fonte,
    accrual_r_evento_fonte r_ev_fonte,
    accrual_r_causale_stato r_cau_stato,
    accrual_d_causale_stato d_cau_stato
where evento.evento_id=cau.evento_id
and evento.evento_id=r_ev_fonte.evento_id
and r_ev_fonte.fonte_id=fonte.fonte_id
and r_cau_stato.causale_id=cau.causale_id
and r_cau_stato.causale_stato_id=d_cau_stato.causale_stato_id
and evento.ente_id=?
and d_cau_stato.causale_stato_codice='V'
and r_cau_stato.gest_data_del IS NULL 
and evento.gest_data_del IS NULL
and cau.gest_data_del IS NULL   
and fonte.gest_data_del IS NULL    
and r_ev_fonte.gest_data_del IS NULL   
and r_cau_stato.gest_data_del IS NULL 
UNION
select fonte.fonte_codice, fonte.fonte_descrizione,
	fonte.fonte_codice||' - '||fonte.fonte_descrizione fonte_completa,
    evento.evento_codice, evento.evento_descrizione, 
    evento.evento_codice||' - '||evento.evento_descrizione evento_completo,
    'T' causale_codice, 'Tutte' causale_descrizione,
    'T - Tutte' causale_completa,
    upper(fonte.fonte_codice) ordina_fonte, upper(evento.evento_codice) ordine_codice,
    'ZZZ' ordina_causale
from accrual_t_evento evento, 
	accrual_t_causale cau,
    accrual_d_fonte fonte,
    accrual_r_evento_fonte r_ev_fonte,
    accrual_r_causale_stato r_cau_stato,
    accrual_d_causale_stato d_cau_stato
where evento.evento_id=cau.evento_id
and evento.evento_id=r_ev_fonte.evento_id
and r_ev_fonte.fonte_id=fonte.fonte_id
and r_cau_stato.causale_id=cau.causale_id
and r_cau_stato.causale_stato_id=d_cau_stato.causale_stato_id
and evento.ente_id=?
and d_cau_stato.causale_stato_codice='V'
and evento.gest_data_del IS NULL
and cau.gest_data_del IS NULL   
and fonte.gest_data_del IS NULL    
and r_ev_fonte.gest_data_del IS NULL  
and r_cau_stato.gest_data_del IS NULL
UNION
select 'T' fonte_codice, 'Tutte' fonte_descrizione,
	'T - Tutte' fonte_completa,
    'T' evento_codice, 'T- Tutti' evento_descrizione, 
    'T - Tutti' evento_completo,
    cau.causale_codice, cau.causale_descrizione,
    cau.causale_codice||' - '|| cau.causale_descrizione causale_completa,
    'ZZZ' ordina_fonte, 'ZZZ' ordine_codice, upper(cau.causale_codice) ordina_causale
from accrual_t_evento evento, 
	accrual_t_causale cau,
    accrual_d_fonte fonte,
    accrual_r_evento_fonte r_ev_fonte,
    accrual_r_causale_stato r_cau_stato,
    accrual_d_causale_stato d_cau_stato
where evento.evento_id=cau.evento_id
and evento.evento_id=r_ev_fonte.evento_id
and r_ev_fonte.fonte_id=fonte.fonte_id
and r_cau_stato.causale_id=cau.causale_id
and r_cau_stato.causale_stato_id=d_cau_stato.causale_stato_id
and evento.ente_id=?
and d_cau_stato.causale_stato_codice='V'
and evento.gest_data_del IS NULL
and cau.gest_data_del IS NULL   
and fonte.gest_data_del IS NULL    
and r_ev_fonte.gest_data_del IS NULL   
and r_cau_stato.gest_data_del IS NULL
UNION
select 'T' fonte_codice, 'Tutte' fonte_descrizione,
	'T - Tutte' fonte_completa,
    evento.evento_codice, evento.evento_descrizione, 
    evento.evento_codice||' - '||evento.evento_descrizione evento_completo,
    'T' causale_codice, 'Tutte' causale_descrizione,
    'T - Tutte' causale_completa,
    'ZZZ' ordina_fonte, upper(evento.evento_codice) ordine_codice,
    'ZZZ' ordina_causale
from accrual_t_evento evento, 
	accrual_t_causale cau,
    accrual_d_fonte fonte,
    accrual_r_evento_fonte r_ev_fonte,
    accrual_r_causale_stato r_cau_stato,
    accrual_d_causale_stato d_cau_stato
where evento.evento_id=cau.evento_id
and evento.evento_id=r_ev_fonte.evento_id
and r_ev_fonte.fonte_id=fonte.fonte_id
and r_cau_stato.causale_id=cau.causale_id
and r_cau_stato.causale_stato_id=d_cau_stato.causale_stato_id
and evento.ente_id=?
and d_cau_stato.causale_stato_codice='V'
and evento.gest_data_del IS NULL
and cau.gest_data_del IS NULL   
and fonte.gest_data_del IS NULL    
and r_ev_fonte.gest_data_del IS NULL   
and r_ev_fonte.gest_data_del IS NULL   
and r_cau_stato.gest_data_del IS NULL
UNION
select fonte.fonte_codice, fonte.fonte_descrizione,
	fonte.fonte_codice||' - '||fonte.fonte_descrizione fonte_completa,
    'T' evento_codice, 'T- Tutti' evento_descrizione, 
