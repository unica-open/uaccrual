                    <expression name="expression" type="javascript">if (params["NumProvvisorio"].value == null || params["NumProvvisorio"].value == 0) {&#13;
	var numProvv = "";&#13;
}&#13;
else var numProvv =params["NumProvvisorio"].value;&#13;
&#13;
if (params["data_da_provv"].value == null)  {&#13;
	var dataDaProvv = "";&#13;
}&#13;
else var dataDaProvv =' Da '+ Formatter.format(params["data_da_provv"].value,'dd/MM/yyyy');	&#13;
if (params["data_a_provv"].value == null)  {&#13;
	var dataAProvv = "";&#13;
}&#13;
else var dataAProvv =' a '+ Formatter.format(params["data_a_provv"].value,'dd/MM/yyyy');	&#13;
&#13;
"N. e data provvisori: "+numProvv+dataDaProvv+dataAProvv</expression>
