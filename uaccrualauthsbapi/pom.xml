				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<pluginRepositories>
		<pluginRepository>
			<id>csi-repart</id>
			<name>CSI Repart</name>
			<url>https://repart.csi.it/maven2</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>application-*.properties</exclude>
					<exclude>application-*.yaml</exclude>
					<exclude>application-*.yml</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>auto-clean</id>
						<phase>initialize</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<filesets>
								<!-- <fileset>
								<directory>${project.basedir}/src/main/java/it/csi/accrual/accrualauthsbapi/api/dto</directory>
                                    <includes>
                                        <include>**/*</include>
                                    </includes>
                                    <followSymlinks>false</followSymlinks>
                                </fileset> -->
							</filesets>
						</configuration>
					</execution>
					<execution>
						<id>clean-old-generated-sources</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<filesets>
								<fileset>
									<directory>
										${project.basedir}/src/main/java/it/csi/accrual/accrualauthsbapi/api</directory>
									<includes>
										<include>**/*</include>
									</includes>
									<followSymlinks>false</followSymlinks>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>create-swagger-gen-dir</id>
						<phase>initialize</phase>
						<goals>
							<goal>resources</goal>
						</goals>
						<configuration>
							<outputDirectory>
								${project.build.directory}/generated-sources/swagger</outputDirectory>
							<resources>
								<resource>
									<directory>${project.basedir}</directory>
									<includes>
										<include>nonexistentfile.txt</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
						<path>
							<groupId>org.mapstruct</groupId>
							<artifactId>mapstruct-processor</artifactId>
							<version>${org.mapstruct.version}</version>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok-mapstruct-binding</artifactId>
							<version>0.2.0</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
				<executions>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<compileSourceRoots>
								<compileSourceRoot>
									${project.basedir}/src/main/java</compileSourceRoot>
								<compileSourceRoot>
									${project.basedir}/src/test/java</compileSourceRoot>
								<compileSourceRoot>${swagger-generated-sources}</compileSourceRoot>
							</compileSourceRoots>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>io.swagger.codegen.v3</groupId>
				<artifactId>swagger-codegen-maven-plugin</artifactId>
				<version>${swagger-codegen-maven-plugin-version}</version>
				<executions>
					<execution>
						<id>jaxrs_exposed_api</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>
								${project.basedir}/src/main/resources/META-INF/openapi.yaml</inputSpec>
							<language>csi-jaxrs-resteasy</language>
							<output>${swagger-generated-sources}</output>
							<apiPackage>${default.package}.handler</apiPackage>
							<modelPackage>${default.package}.model</modelPackage>
							<invokerPackage>${default.package}.handler</invokerPackage>
							<configOptions>
								<java8>false</java8>
								<useBeanValidation>true</useBeanValidation>
								<hideGenerationTimestamp>true</hideGenerationTimestamp>
								<apiPackage>it.csi.accrual.accrualauthsbapi.be</apiPackage>
								<modelPackage>
									it.csi.accrual.accrualauthsbapi.dto</modelPackage>
								<invokerPackage>
									it.csi.accrual.accrualauthsbapi.be</invokerPackage>
								<implFolder>implfolder</implFolder>
								<sourceFolder>/</sourceFolder>
								<generateJbossDeploymentDescriptor>false</generateJbossDeploymentDescriptor>
								<generateImplArtifacts>false</generateImplArtifacts>
								<generateSwaggerMetadata>false</generateSwaggerMetadata>
								<attributeSerializationStrategy>
									implicit-snake-case</attributeSerializationStrategy>
								<accessHttpHeaders>true</accessHttpHeaders>
								<accessHttpRequest>true</accessHttpRequest>
								<jeeLibrary>jakarta</jeeLibrary>
								<useSwaggerFeature>false</useSwaggerFeature>
							</configOptions>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>it.csi.apitools</groupId>
						<artifactId>csi-java-swagger3-codegen</artifactId>
						<version>1.1.1.001</version>
						<exclusions>
							<exclusion>
								<groupId>javax.validation</groupId>
								<artifactId>validation-api</artifactId>
							</exclusion>
						</exclusions>
					</dependency>
				</dependencies>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>add-source</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${swagger-generated-sources}</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>replace-javax-with-jakarta</id>
						<phase>process-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<echo
									message="Replacing javax.validation with jakarta.validation in generated sources..." />
								<replaceregexp
									byline="false"
									match="javax.validation.constraints"
									replace="jakarta.validation.constraints"
									flags="g"
									encoding="UTF-8"
								>
									<fileset dir="${swagger-generated-sources}"
										includes="**/*.java" />
								</replaceregexp>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<appendAssemblyId>false</appendAssemblyId>
					<descriptors>
						<descriptor>src/assembly/src.xml</descriptor>
					</descriptors>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>


			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
			  <groupId>org.cyclonedx</groupId>
			  <artifactId>cyclonedx-maven-plugin</artifactId>
			  <version>2.7.10</version>
			  <executions>

				<!-- BOM COMPLETO (per CSI) -->
				<execution>
				  <id>bom-full</id>
				  <phase>verify</phase>
				  <goals>
					<goal>makeAggregateBom</goal>
				  </goals>
				  <configuration>
					<outputName>bom</outputName>
				  </configuration>
				</execution>

				<!-- BOM SEMPLICE (solo dipendenze dirette) -->
				<execution>
				  <id>bom-simple</id>
				  <phase>verify</phase>
				  <goals>
					<goal>makeBom</goal>
				  </goals>
				  <configuration>
					<includeTransitiveDependencies>false</includeTransitiveDependencies>
					<outputName>bom_simple</outputName>
				  </configuration>
				</execution>

			  </executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>local</id>
