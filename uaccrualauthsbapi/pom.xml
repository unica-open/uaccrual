			<properties>
				<spring.profiles.active>prod-int-01</spring.profiles.active>
			</properties>
		</profile>
		<profile>
			<id>exclude-app-config</id>
			<build>
				<resources>
					<resource>
						<directory>src/main/resources</directory>
						<excludes>
							<exclude>application*.properties</exclude>
							<exclude>application-*.properties</exclude>
							<exclude>application-*.yml</exclude>
							<exclude>application-*.yaml</exclude>
							</excludes>
