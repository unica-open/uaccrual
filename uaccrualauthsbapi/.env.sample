# ===========================================
# ACCRUALAUTHSBAPI - Environment Configuration
# ===========================================
# Copia questo file in .env e personalizza i valori
# MAI committare il file .env con valori reali!

# ===========================================
# JWT Configuration
# ===========================================
# Segreto per la firma dei token JWT (minimo 32 caratteri consigliato)
# Genera un valore sicuro: openssl rand -base64 32
JWT_SECRET=inserisci_qui_tuo_jwt_secret_sicuro

# Durata token JWT in secondi (86400 = 24 ore)
JWT_EXPIRATION=86400

# ===========================================
# Mail Configuration (SMTP)
# ===========================================
# Password per l'account email di servizio
# Utilizzare app password se si usa Gmail con 2FA
MAIL_PASSWORD=inserisci_qui_password_email

# ===========================================
# Note per il Team
# ===========================================
# 1. Copia questo file: cp .env.sample .env
# 2. Sostituisci i valori placeholder con quelli reali
# 3. NON committare mai il file .env
# 4. Per ambiente di sviluppo locale puoi usare valori dummy
# 5. Per produzione usa valori sicuri e custodiscili in vault

# ===========================================
# Esempio valori per sviluppo (NON USARE IN PRODUZIONE)
# ===========================================
# JWT_SECRET=sviluppo_secret_non_usare_in_produzione_12345
# JWT_EXPIRATION=86400
# MAIL_PASSWORD=password_dummy_per_testing
