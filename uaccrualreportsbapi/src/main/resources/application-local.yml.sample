# ===========================================
# ACCRUALREPORTSBAPI - Local Development Configuration
# ===========================================
# Configurazione per ambiente di sviluppo locale
# Questo file viene caricato quando SPRING_PROFILES_ACTIVE=local

# ===========================================
# SERVER CONFIGURATION
# ===========================================
server:
  port: 20180

# ===========================================
# DEVELOPMENT AUTHENTICATION
# ===========================================
# Abilita autenticazione dev con token base64 (senza JWT)
# Il frontend invia token dev, il backend lo decodifica e autentica
dev:
  auth:
    enabled: true

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

spring:
  datasource:
    url: jdbc:postgresql://0.0.0.0:5432/ACCRUAL
    username: accrual
    password: xxxx
    driver-class-name: org.postgresql.Driver
    hikari:
      minimum-idle: 5
      maximum-pool-size: 15
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000
      auto-commit: true
      pool-name: BirtHikariPool



# ===========================================
# LOGGING CONFIGURATION
# ===========================================
logging:
  level:
    root: INFO
    it.csi.accrual.accrualreportsbapi: DEBUG
    org.springframework: WARN
    org.springframework.boot.actuate: INFO
    org.eclipse.birt: WARN
    org.hibernate: INFO
    org.postgresql: WARN
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{enteCodice}] [%X{requestId}] %msg%n"
    file: "%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [%X{enteCodice}] [%X{requestId}] %msg%n"
  file:
    name: ${LOG_PATH:C:/logs/accrualreportsbapi.log}
    max-size: 10MB
    max-history: 30

# ===========================================
# SPECIFIC CONFIGURATION (BIRT)
# ===========================================
# BIRT Reports Directory (locale)
birt:
  locale: it_IT
  reports:
    directory: C:/workspaces/siacaccrual/accrualreport/src
