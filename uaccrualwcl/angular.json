          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "accrualwcl-ng:build:production"
            },
            "development": {
              "buildTarget": "accrualwcl-ng:build:development",
              "proxyConfig": "proxy.conf.json"
            },
            "test": {
              "buildTarget": "accrualwcl-ng:build:test",
              "proxyConfig": "proxy.conf.test.json"
            },
            "dev-local": {
              "buildTarget": "accrualwcl-ng:build:local",
              "proxyConfig": "proxy.conf.dev.json"
            },
            "docker": {
              "buildTarget": "accrualwcl-ng:build:docker",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
